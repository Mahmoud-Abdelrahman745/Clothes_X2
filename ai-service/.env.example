# Clothing analysis service - configuration
#
# Copy to `.env` and edit. Every variable is optional: the defaults below are the
# values the service uses when the variable is absent, so an empty file is a
# valid file.
#
# The prefix is CLOTHING_AI_. Settings resolve in this order:
#   explicit argument > environment variable > .env file > built-in default
#
# There is no secrets section on purpose. The service needs no API keys and
# writes nothing it cannot rebuild, so there is nothing here to leak.
#
# To keep several environments side by side, point each at its own file and
# skip the copy step entirely:
#   CLOTHING_AI_ENV_FILE=./.env.staging

# ------------------------------------------------------------------ logging --

# DEBUG | INFO | WARNING | ERROR | CRITICAL
CLOTHING_AI_LOG_LEVEL=INFO

# true emits one JSON object per line, for log shipping. false is human-readable.
CLOTHING_AI_LOG_JSON=false

# -------------------------------------------------------------------- paths --

# Where benchmark data and evaluation reports are written.
CLOTHING_AI_DATA_DIR=./data

# Model weights. Keep this on a drive with several GB free; it is not
# reproducible from source and re-downloading is slow.
CLOTHING_AI_MODEL_CACHE_DIR=./.model-cache

# Benchmark annotations. See "Evaluating" in README.md for the format.
CLOTHING_AI_ANNOTATIONS_FILE=./data/annotations/dataset.json

# Vocabulary and validation rules. These are the main tuning knobs: the
# confidence caps live in labels.yaml, the review rules in validation_rules.yaml.
CLOTHING_AI_LABELS_FILE=./clothing_ai/config/labels.yaml
CLOTHING_AI_VALIDATION_RULES_FILE=./clothing_ai/config/validation_rules.yaml

# ------------------------------------------------------------------- models --

# Object detector. Outputs coarse groups: bag, bottom, dress, hat, shoes, outer,
# top. Fine-grained category comes from the embedding model below.
CLOTHING_AI_DETECTOR_MODEL=yainage90/fashion-object-detection

# Promptable segmenter. Produces the mask that restricts colour measurement and
# cropping to the garment.
CLOTHING_AI_SEGMENTER_MODEL=facebook/sam2.1-hiera-tiny

# Zero-shot attribute model. 768-d embeddings, drives category/colour/pattern/
# style/material.
CLOTHING_AI_FASHION_MODEL=hf-hub:Marqo/marqo-fashionSigLIP

# Optional second opinion on category. Off by default: it roughly doubles
# inference time and its disagreements are not currently resolved into anything
# useful. See MODEL_LICENSES.md.
CLOTHING_AI_ENABLE_SECONDARY_CLASSIFIER=false
CLOTHING_AI_SECONDARY_CLASSIFIER_MODEL=

# ---------------------------------------------------------------- execution --

# auto | cpu | cuda. "auto" uses CUDA when it is actually available and falls
# back to CPU otherwise.
CLOTHING_AI_DEVICE=auto

# 0 lets torch decide. Set a value to cap threads on a shared machine.
CLOTHING_AI_TORCH_THREADS=0

# true seeds the RNGs so KMeans clustering and sampling are reproducible, which
# is what makes an accuracy number mean anything across runs.
CLOTHING_AI_DETERMINISTIC=true
CLOTHING_AI_SEED=20260929

# Load every model at startup instead of on first request. Prefer true: with
# false, the first user pays a multi-minute cold download.
CLOTHING_AI_EAGER_LOAD=true

# true forbids any network access, for a machine that must never phone home.
# Requires a warm cache.
CLOTHING_AI_OFFLINE=false

# ------------------------------------------------------------------- limits --

# 12 MiB. A 12 MP phone photo is well under this; the cap is there to stop a
# single request from exhausting memory.
CLOTHING_AI_MAX_UPLOAD_BYTES=12582912

# Longer edge after decode. Larger inputs are downscaled, which is what keeps
# memory bounded on CPU.
CLOTHING_AI_MAX_IMAGE_DIMENSION=2048

# Most garments returned for one image. A photo of one coat is not expected to
# produce eight.
CLOTHING_AI_MAX_GARMENTS=8

# Extra inference passes allowed for a low-confidence garment. 0 disables
# retries; each one costs roughly as much as a full pass.
CLOTHING_AI_MAX_RETRIES=1

# Server-side budget for one analysis, in seconds.
CLOTHING_AI_REQUEST_TIMEOUT_S=120.0

# ---------------------------------------------------------------- confidence --
#
# These are the thresholds that turn a score into a decision. They are service
# policy, not model properties, which is why they live here rather than in the
# scorer.

# At or above this, an item is accepted silently.
CLOTHING_AI_ACCEPT_THRESHOLD=0.7

# Below this, the item is returned as `uncertain` and flagged for review.
CLOTHING_AI_UNCERTAIN_THRESHOLD=0.45

# Below this, an individual attribute is omitted rather than returned at low
# confidence. A 0.2-confidence "material: silk" is worse than no material, because
# a client renders it as a fact.
CLOTHING_AI_REPORT_FLOOR=0.2

# Multiplier on validation penalties. Raise it to make cross-model conflicts
# (for example, the embedding model saying "brown" while the pixels measure
# "blue") bite harder.
CLOTHING_AI_VALIDATION_PENALTY_SCALE=1.0
